			"properties": {
				"annotations": [],
				"type": "FileServer",
				"typeProperties": {
					"host": "[parameters('LinkedService_OnPremise_properties_typeProperties_host')]",
					"userId": "[parameters('LinkedService_OnPremise_properties_typeProperties_userId')]",
					"password": {
