			"type": "string",
			"defaultValue": "‪\\Users\\vinay\\Downloads\\"
		},
		"LinkedService_OnPremise_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "desktop-gllttbs\\vinay"
		}
	},
